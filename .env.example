# Server Configuration
NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/voice_banking
# Or use MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/voice_banking

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# OpenAI API Configuration (for Whisper Speech-to-Text and GPT NLP)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Cloud Speech API (Alternative to Whisper)
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# Text-to-Speech Configuration
TTS_PROVIDER=openai
# Options: openai, google, coqui

# Twilio Configuration (for SMS and IVR)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# Payment Gateway Configuration
# Razorpay (for UPI/IMPS)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Paytm Business
PAYTM_MERCHANT_ID=your_merchant_id
PAYTM_MERCHANT_KEY=your_merchant_key
PAYTM_WEBSITE=WEBSTAGING
PAYTM_INDUSTRY_TYPE=Retail
PAYTM_CHANNEL_ID=WEB
PAYTM_CALLBACK_URL=http://localhost:5000/api/payment/callback

# UPI Configuration
UPI_VPA=your-vpa@bankname
UPI_MERCHANT_NAME=Voice Banking
UPI_MERCHANT_CODE=1234

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Security Configuration
SESSION_SECRET=your_session_secret_key
ENCRYPTION_KEY=your_32_character_encryption_key
CORS_ORIGIN=http://localhost:3000,http://localhost:5500

# Voice Authentication
VOICEPRINT_THRESHOLD=0.85
VOICEPRINT_MIN_SAMPLES=3

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
# Options: error, warn, info, debug

# SMS Service Provider
SMS_PROVIDER=twilio
# Options: twilio, msg91, aws_sns

# AWS Configuration (if using AWS services)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=voice-banking-audio

# Feature Flags
ENABLE_VOICEPRINT_AUTH=true
ENABLE_SMS_FALLBACK=true
ENABLE_IVR_SUPPORT=true
ENABLE_WHATSAPP_NOTIFICATIONS=true
ENABLE_OFFLINE_MODE=true

# Language Models
DEFAULT_LANGUAGE=hi-IN
SUPPORTED_LANGUAGES=hi-IN,or-IN,bn-IN,ta-IN,te-IN,kn-IN,mr-IN,gu-IN,en-IN

# Audio Configuration
MAX_AUDIO_SIZE_MB=5
AUDIO_SAMPLE_RATE=16000
AUDIO_FORMAT=wav

# Transaction Limits
MIN_TRANSACTION_AMOUNT=1
MAX_TRANSACTION_AMOUNT=50000
DAILY_TRANSACTION_LIMIT=100000

# Session Configuration
SESSION_TIMEOUT_MINUTES=15
MAX_ACTIVE_SESSIONS=3

# Notification Settings
ENABLE_SMS_ALERTS=true
ENABLE_EMAIL_ALERTS=false
ENABLE_PUSH_NOTIFICATIONS=false
