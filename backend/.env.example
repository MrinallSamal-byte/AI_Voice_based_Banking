# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/voice_banking
DB_NAME=voice_banking

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=24h

# OpenAI API (for voice processing)
OPENAI_API_KEY=your_openai_api_key_here

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# UPI/Payment Gateway (Mock for development)
UPI_API_KEY=your_upi_api_key
UPI_API_SECRET=your_upi_api_secret
RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Voice Recognition Settings
VOICE_CONFIDENCE_THRESHOLD=0.7
MAX_AUDIO_DURATION=30

# Security Settings
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900000

# SMS Fallback
SMS_ENABLED=true
SMS_PROVIDER=twilio

# Language Support
DEFAULT_LANGUAGE=hi-IN
SUPPORTED_LANGUAGES=hi-IN,or-IN,bn-IN,ta-IN,te-IN,kn-IN,mr-IN,gu-IN,en-IN

# Cache Settings
CACHE_TTL=3600

# Transaction Limits
DAILY_TRANSFER_LIMIT=50000
MIN_TRANSFER_AMOUNT=1
MAX_TRANSFER_AMOUNT=25000
DAILY_TRANSACTION_COUNT_LIMIT=20

# Feature Flags
ENABLE_QR_PAYMENTS=true
ENABLE_SCHEDULED_PAYMENTS=true
ENABLE_SAVINGS_GOALS=true
ENABLE_BILL_REMINDERS=true
ENABLE_BENEFICIARY_MANAGEMENT=true
ENABLE_TRANSACTION_DISPUTES=true
ENABLE_ANALYTICS=true

# Alert Settings
LOW_BALANCE_THRESHOLD=500
SMS_ALERT_ENABLED=true
VOICE_ALERT_ENABLED=true
